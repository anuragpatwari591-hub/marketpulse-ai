# MarketPulse AI - environment configuration
# Copy this file to .env and fill in only what you have. Every provider
# falls back to its demo implementation automatically if credentials are
# missing, so the app runs fully with NONE of these set.

ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Provider selection ---------------------------------------------------
# Each of these accepts "demo" (default, no credentials needed) or a live
# provider name once that integration is implemented.
MARKET_DATA_PROVIDER=demo
NEWS_PROVIDER=demo
CORPORATE_DATA_PROVIDER=demo
BROKER_PROVIDER=none
LLM_PROVIDER=demo
NOTIFICATION_PROVIDER=none

# --- Optional external credentials (REQUIRED only if the matching ------
# provider above is switched away from "demo"/"none") ---------------------
# MARKET_DATA_API_KEY=
# NEWS_API_KEY=
# LLM_API_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Demo data ------------------------------------------------------------
DEMO_RANDOM_SEED=42

# --- Infrastructure (optional - app runs in-memory without these) --------
# DATABASE_URL=postgresql://marketpulse:marketpulse@localhost:5432/marketpulse
# REDIS_URL=redis://localhost:6379/0

# --- Frontend ---------------------------------------------------------------
# VITE_API_BASE_URL=http://localhost:8000/api/v1
